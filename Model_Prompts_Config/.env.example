# ==============================================================================
# AUTOSAR HLD Intelligence & Traceability Assistant — Environment Configuration
# ==============================================================================
# Copy this file to .env in the project root to configure your local runtime:
#   copy Model_Prompts_Config\.env.example .env     (Windows PowerShell / CMD)
#   cp Model_Prompts_Config/.env.example .env        (Linux / macOS)
#
# IMPORTANT SECURITY NOTICE:
# - Never commit real API keys, credentials, or secrets to version control.
# - The active .env file is excluded in .gitignore and .dockerignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Active LLM provider selection:
#   'ollama'  : Local offline inference via Ollama (Default, private, zero cost)
#   'gemini'  : Cloud development via Google Gemini Free-Tier (Requires GEMINI_API_KEY)
#   'mock'    : Deterministic mock provider for automated unit testing and CI
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 2. Local Ollama Settings (Offline / Private Engineering Path)
# ------------------------------------------------------------------------------
# Base URL for local Ollama instance:
#   Host execution:  http://localhost:11434
#   Docker container: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Recommended local model (3 billion parameter instruction-tuned model):
OLLAMA_MODEL=qwen2.5:3b

# ------------------------------------------------------------------------------
# 3. Google Gemini Settings (Cloud Free-Tier Path — Optional)
# ------------------------------------------------------------------------------
# Leave empty when running offline with Ollama.
# If LLM_PROVIDER=gemini, provide your Google AI Studio API key below:
GEMINI_API_KEY=replace-with-your-own-key

# Active Gemini model identifier:
GEMINI_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 4. LLM Generation Parameters
# ------------------------------------------------------------------------------
# Sampling temperature (0.1 enforces deterministic engineering Q&A):
LLM_TEMPERATURE=0.1

# Maximum output tokens generated per answer:
LLM_MAX_OUTPUT_TOKENS=2000

# Client timeout in seconds for generation requests:
LLM_TIMEOUT_SECONDS=180

# ------------------------------------------------------------------------------
# 5. Embedding Model & Vector Retrieval Configuration
# ------------------------------------------------------------------------------
# HuggingFace model identifier for 384-dimensional dense semantic embeddings:
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Default number of top evidence chunks to retrieve per question:
TOP_K=5

# Maximum character limit for structural chunking:
CHUNK_MAX_CHARS=1500

# Default project scope identifier for document catalog partitioning:
PROJECT_ID=demo_project

# ------------------------------------------------------------------------------
# 6. Service-to-Service Networking Configuration
# ------------------------------------------------------------------------------
# FastAPI backend base URL for Streamlit UI communication:
#   Host execution:  http://localhost:8000
#   Docker Compose:  http://hld-api:8000
API_BASE_URL=http://localhost:8000

# Force CPU inference for PyTorch & SentenceTransformers (prevents CUDA warnings):
CUDA_VISIBLE_DEVICES=""