# AUTOSAR HLD Intelligence & Traceability Assistant Configuration
# Copy this file to .env and configure your GEMINI_API_KEY for Docker or Cloud deployment.
# Never commit real API keys to version control.

# Primary LLM Provider: 'gemini' (Default for Docker / Cloud), 'ollama' (Local non-Docker), or 'mock' (Unit Tests)
LLM_PROVIDER=gemini

# Google Gemini Cloud Configuration (Required for Docker deployment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Generation Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=500
LLM_TIMEOUT_SECONDS=180

# Vector Embedding & Retrieval Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5
CHUNK_MAX_CHARS=1500
PROJECT_ID=demo_project

# Optional Local Ollama Configuration (For non-Docker local host execution only)
# OLLAMA_BASE_URL=http://localhost:11434 (defaults to localhost on host, host.docker.internal in Docker)
OLLAMA_MODEL=qwen2.5:3b
